# =================================================================
# Message Board Frontend Configuration
# =================================================================

# API URL - Backend endpoint
# ===========================
# Points to your deployed backend API
#
# Development: http://localhost:8000/api
# Production:  https://your-backend.railway.app/api
#
# Note: No trailing slash!
VITE_API_URL=http://localhost:8000/api

# =================================================================
# Deployment Notes
# =================================================================
#
# Vite Environment Variables:
# - All environment variables must be prefixed with VITE_ to be exposed
# - Access in code using: import.meta.env.VITE_API_URL
#
# Local Development:
# 1. Copy this file to .env
# 2. Update VITE_API_URL if your backend runs on a different port
# 3. Restart dev server after changing .env
#
# Production Deployment (Vercel, Netlify, etc.):
# 1. Set VITE_API_URL in your hosting platform's environment variables
# 2. Point it to your deployed backend URL
# 3. Make sure backend CORS allows your frontend URL
#
# =================================================================
