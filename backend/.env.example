# =================================================================
# Message Board Backend Configuration
# =================================================================

# MASTER KEY - For password reset functionality
# ================================================
# This key allows password resets when users are locked out.
# CRITICAL: Keep this secret and secure! Anyone with this key can reset passwords.
#
# To generate a secure key, run:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Store this key somewhere safe (password manager, secure notes, etc.)
# Example: dXNlcnM6cGFzc3dvcmQ=
MASTER_KEY=your-secure-master-key-here

# PI CLIENT API KEY - For Raspberry Pi authentication
# ====================================================
# This key allows the Pi clients to fetch messages without user login.
# Generate a different key than MASTER_KEY for security.
#
# To generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# This key will be added to pi-client/config.py
PI_API_KEY=your-pi-api-key-here

# CORS ORIGINS - Frontend URLs allowed to access the API
# =======================================================
# Comma-separated list of frontend URLs
# Development: http://localhost:5173,http://localhost:3000
# Production: https://your-frontend.vercel.app
#
# Examples:
#   Development: CORS_ORIGINS=http://localhost:5173,http://localhost:3000
#   Production:  CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =================================================================
# Deployment Notes
# =================================================================
#
# 1. Backend Deployment (Railway, Render, etc.):
#    - Set these environment variables in your hosting platform
#    - Make sure CORS_ORIGINS points to your actual frontend URL
#    - Never commit the actual .env file to git!
#
# 2. Pi Client Setup:
#    - Copy PI_API_KEY to pi-client/config.py
#    - Update API_URL in pi-client/config.py to point to your backend
#
# 3. Frontend Deployment (Vercel, Netlify, etc.):
#    - Set VITE_API_URL to your backend URL
#    - See frontend/.env.example for details
#
# =================================================================
